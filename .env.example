# Firebase (client-side — safe to expose)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Firebase Cloud Messaging (Phase 2 — optional for FCM token registration)
# Get from Firebase Console → Project Settings → Cloud Messaging
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=

# Anthropic (server-side only — DO NOT prefix with VITE_)
# Used by api/claude.ts (Vercel Edge Function)
# For local dev: run `vercel dev` so the /api route is served
ANTHROPIC_API_KEY=
